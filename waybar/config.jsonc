// sway/config.jsonc
{
  "layer": "top",
  "position": "top",
  "autohide": true,
  "autohide-blocked": false,
  "exclusive": true,
  "passthrough": false,
  "gtk-layer-shell": true,
  "modules-left": ["custom/archicon", "clock", "cpu", "memory", "disk"],

  "modules-center": [],
  "backlight/slider": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
    "device": "intel_backlight"
  },

  "modules-right": [
    "temperature",
    "battery",
    "backlight/slider",

    "network",
    "pulseaudio/slider"
  ],
  "custom/archicon": {
    "format": "󰣇",
    "tooltip": true,
    "tooltip-format": "I use arch btw"
  },
  "clock": {
    "timezone": "Asia/Manila",
    "format": "{:%I:%M  %d-%m-%y}",
    "tooltip-format": "{calendar}",
    "calendar": {
      "mode": "month"
    }
  },
  "cpu": {
    "format": "{usage}% ",
    "tooltip": true
  },
  "memory": {
    "format": "{}% 󰍛",
    "tooltip": true,
    "tooltip-format": "RAM in use: {used} / {total} ({percentage}%)"
  },
  "disk": {
    "format": "{percentage_free}% ",
    "tooltip": true,
    "tooltip-format": "Disk free: {free} / {total} ({percentage_free}%)"
  },
  "temperature": {
    "format": "{temperatureF}°F {icon}",
    "tooltip": false,
    "format-icons": [""]
  },
  "pulseaudio/slider": {
    "format": "{volume}%",
    "format-muted": "MUTE",
    "step": 1,
    "tooltip": false
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "{format_source}",
    "format-icons": {
      "default": ["", ""]
    }
  },
  "network": {
    "format": "{ifname}",
    "format-ethernet": "{ifname} Ethernet",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "tooltip-format-ethernet": "{ifname} {ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  }
}
